<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 连 NAS 内核：release 构建不会像 debug 那样自动补 INTERNET -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 息屏后继续播音频 / 传完未完成的转码任务 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 后台续播：前台服务 + 通知栏 / 锁屏控制（Android 14+ 必须声明服务类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- 相册备份前台服务（dataSync）：Android 14+ 必须按类型声明并申请对应权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 13+ 不申请这一条，通知栏看不到备份进度（服务仍会保活） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 手机相册备份（photo_manager）：插件自己只声明了 maxSdk=32 的
         READ_EXTERNAL_STORAGE，Android 13+ 不补这两条就永远拿不到相册权限。
         ACCESS_MEDIA_LOCATION 用于读取原图 EXIF 里的 GPS。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
    <!-- 客户端自更新：下载 APK 后交给系统安装器（不申请则 Intent 直接被拦） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Android TV：应用要能装到没有触摸屏、没有 Leanback 的设备上（手机/盒子通用清单），
         所以两条都声明为非必需；TV 桌面入口见 MainActivity 的 LEANBACK_LAUNCHER intent-filter。 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true">
        <!-- 自更新下载的 APK 在应用私有目录里，必须经 FileProvider 才能给系统安装器读 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- P2：Flutter 以透明背景渲染（MainActivity#getBackgroundMode），
                 视频画面由垫在 FlutterView 下面的原生 SurfaceView 提供，
                 Flutter 用透明像素把它露出来。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android TV 桌面入口：单独一条 filter（不能和上面的 LAUNCHER 混在一条里，
                 TV 桌面只带 LEANBACK_LAUNCHER 一个 category，混在一起会匹配不上）。
                 手机桌面只查 LAUNCHER，因此这条不影响手机端入口与行为。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- P0.5 临时探针：只由 App 内部（播放信息面板标题长按）拉起，
             exported=false 不对外开放；验证完与 DvProbeActivity.kt 一起删除。 -->
        <activity
            android:name=".DvProbeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- audio_service：前台服务（进程在后台 / 熄屏时不被冻结）+ 媒体键广播。
             MainActivity 必须继承 AudioServiceActivity，点通知才能回到 App。 -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- 相册备份前台服务：进程切后台 / 熄屏时保活，通知栏显示「备份中」+ 进度。
             与上面的音频服务分开，避免抢同一个 MediaSession 通知。 -->
        <service
            android:name=".BackupForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- 离线下载前台服务：息屏 / 切后台时保活，通知栏显示「下载中」+ 进度。
             与备份服务分开是因为一个 Service 只能有一个前台通知，共用会互相顶掉。 -->
        <service
            android:name=".DownloadForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- 视频媒体会话：播放电影时挂出通知栏 / 状态栏的媒体卡（标题、暂停继续、
             进度），并由 Media3 自动申请音频焦点，顶掉音乐 / 播客 / 其它 App。 -->
        <service
            android:name=".VideoMediaSessionService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <!-- 音乐 / AI 播客的媒体面板：自己持 MediaSession + MediaStyle 通知。
             audio_service 自动生成的通知在部分国产 ROM 上不显示（与视频同一个坑），
             这里改用与视频相同的自建前台服务。 -->
        <service
            android:name=".AudioPanelService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
